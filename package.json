{
  "name": "bahis",
  "private": true,
  "version": "3.1.0-dev",
  "author": "Chameleon Ecosystem",
  "description": "Bangladesh Animal Health Intelligence System",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "prod": "vite --mode production",
