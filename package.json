    "lint-electron": "eslint electron --report-unused-disable-directives",
    "lint-react": "eslint src --report-unused-disable-directives",
    "fix-better-sqlite-build-error": "electron-builder install-app-deps",
    "format": "prettier --write './**/*.{ts,tsx}'"
  },
  "dependencies": {
    "@date-io/date-fns": "^3.2.1",
    "@emotion/react": "^11.7.0",
    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.4.0",
    "@mui/x-data-grid": "^9.14.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.20.0",
    "axios-retry": "^4.5.0",
    "better-sqlite3": "^13.0.3",
    "csv-parser": "^3.0.0",
    "electron-first-run": "^3.0.0",
    "electron-updater": "^6.3.9",
    "enketo-core": "^8.1.0",
    "enketo-transformer": "^4.0.0",
    "highcharts": "^12.6.2",
    "notistack": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "winston": "^3.14.2",
    "xml2js": "^0.6.2",
    "xmlbuilder2": "^3.1.1",
    "xmldom": "^0.6.0",
    "xpath": "^0.0.34"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/lodash": "^4.14.197",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "postcss": "^8.4.47",
    "prettier": "^3.9.8",
    "sass": "^1.81.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js",
  "overrides": {
    "vite-plugin-electron": {
      "electron": "$electron"
    }
